# ─────────────────────────────────────────────────────────────────────────
# Kitchen board — sync configuration
# ─────────────────────────────────────────────────────────────────────────
# This repo is the static frontend only (index.html) — there's no build step,
# so none of this is read by the page directly. It documents what the
# Cloudflare Worker behind CONFIG.workerUrl needs, so a real deploy actually
# syncs live data instead of showing nothing.
#
# Copy this file, fill in real values, and either:
#   - `cp .env.example .dev.vars`   then `wrangler dev` / `wrangler secret put`
#   - or set each one as a Worker secret in the Cloudflare dashboard
# Never commit the filled-in file — .env* is gitignored.
#
# The Worker itself isn't part of this repo (yet). If you haven't built it,
# see the "Worker contract" section in README.md for the exact JSON shape
# it needs to return at /data and /buses.

# Shared secret the board sends as the `X-Kitchen-Key` header on every
# request to /data and /buses. Generate any long random string; the Worker
# must reject requests where this header doesn't match. This is also the
# value you hand the iPad once, as ?key=... on the URL (see README).
KITCHEN_KEY=

# --- Calendars (one per person shown on the board) ---
# CALENDAR_*_NAME is the display name shown on the board — the Worker
# should return it as `people: { a: ..., b: ... }` in the /data response
# (see README's Worker contract). Keep real names out of index.html and
# out of this file once filled in with real values; the board only ever
# shows them to whoever already holds KITCHEN_KEY.
CALENDAR_A_NAME=
CALENDAR_A_ID=                       # Google Calendar ID, or an iCal feed URL
CALENDAR_B_NAME=
CALENDAR_B_ID=

# Only needed if reading calendars via the Google Calendar API rather than
# a public iCal feed.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# --- Weather ---
WEATHER_PROVIDER=                    # e.g. openweathermap, tomorrow.io
WEATHER_API_KEY=
WEATHER_LAT=
WEATHER_LON=

# --- Tides ---
TIDE_STATION_ID=                     # e.g. a DFO/NOAA station code
TIDE_STATION_NAME=Point Atkinson     # shown in the tide card header

# --- Bins / garbage collection ---
BINS_ICAL_URL=                       # your municipality's collection-calendar feed, if it has one

# --- Buses (TransLink) ---
TRANSLINK_API_KEY=
TRANSLINK_STOP_IDS=                  # comma-separated stop IDs to query

# --- CORS ---
# Origin this board is hosted at (e.g. GitHub Pages) — the only origin the
# Worker should accept requests from.
ALLOWED_ORIGIN=
